# PostgreSQL connection string (Neon)
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# Secret used to sign admin JWTs
JWT_SECRET=change-me
PORT=5000

# Optional
# Comma-separated list of allowed origins (default: any origin)
CORS_ORIGIN=https://your-frontend.vercel.app,http://localhost:5173
# How long the in-memory menu cache is fresh before a background refresh (ms, default 300000)
ITEMS_CACHE_TTL_MS=300000
# Max DB connections in the pool (default 10)
PG_POOL_MAX=10
# Set to "disable" to use a local Postgres without SSL
# PGSSLMODE=disable
