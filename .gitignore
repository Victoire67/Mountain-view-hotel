!**/.env.example
!**/.env.sample

# --- Dependencies ---
node_modules/
**/node_modules/
.pnpm-store/

# --- Build output ---
dist/
build/
server/dist/
.vite/
*.tsbuildinfo

# --- Logs ---
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

